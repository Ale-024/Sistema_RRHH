generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════ IAM ════════════════════════════

model Usuario {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password_hash       String
  estado              String    @default("ACTIVO") // ACTIVO | BLOQUEADO | INACTIVO
  intentosFallidos    Int       @default(0)
  bloqueadoHasta      DateTime?
  debeCambiarPassword Boolean   @default(false)
  ultimoAcceso        DateTime?
  mfaSecret           String?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  empleado Empleado?
  roles    UsuarioRol[]
  sesiones SesionRefresh[]

  @@index([estado])
}

model Rol {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique // EMPLEADO | ENCUESTADOR | RRHH_SUP | GERENTE_DEPTO | DIRECCION | ADMIN_TI
  nombre      String
  descripcion String?
  permisos    RolPermiso[]
  usuarios    UsuarioRol[]
}

model PermisoSistema {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique // empleados:leer, planilla:cerrar, auditoria:leer ...
  descripcion String?
  roles       RolPermiso[]
}

model RolPermiso {
  rolId     Int
  permisoId Int
  rol       Rol            @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   PermisoSistema @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

/// scopeDepartamentoId implementa el alcance ABAC que en Postgres
/// resolvía Row Level Security (ver plan, seccion 11.3).
model UsuarioRol {
  usuarioId           Int
  rolId               Int
  scopeDepartamentoId Int?
  asignadoEn          DateTime      @default(now())
  usuario             Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol                 Rol           @relation(fields: [rolId], references: [id])
  scopeDepartamento   Departamento? @relation(fields: [scopeDepartamentoId], references: [id])

  @@id([usuarioId, rolId])
}

/// Refresh tokens rotativos con deteccion de reuso.
model SesionRefresh {
  id           String    @id @default(uuid())
  usuarioId    Int
  tokenHash    String    @unique
  familiaId    String
  expiraEn     DateTime
  revocadoEn   DateTime?
  motivoRevoca String?
  ip           String?
  userAgent    String?
  creadoEn     DateTime  @default(now())
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revocadoEn])
  @@index([familiaId])
}

// ═══════════════════════ ORGANIZACIÓN ═══════════════════════

model Departamento {
  id          Int          @id @default(autoincrement())
  nombre      String
  descripcion String?
  puestos     Puesto[]
  scopes      UsuarioRol[]
}

model Puesto {
  id              Int          @id @default(autoincrement())
  titulo          String
  departamento_id Int
  departamento    Departamento @relation(fields: [departamento_id], references: [id])
  empleados       Empleado[]
}

// ════════════════════════ EMPLEADOS ════════════════════════

model Empleado {
  id                  Int       @id @default(autoincrement())
  usuario_id          Int       @unique
  usuario             Usuario   @relation(fields: [usuario_id], references: [id])
  puesto_id           Int
  puesto              Puesto    @relation(fields: [puesto_id], references: [id])
  nombres             String
  apellidos           String
  dni                 String    @unique
  dni_hmac            String?   @unique /// HMAC para busqueda exacta sin descifrar
  fecha_ingreso       DateTime
  telefono            String?
  direccion           String?
  contacto_emergencia String?
  telefono_emergencia String?
  rtn                 String?
  fecha_nacimiento    DateTime?
  sexo                String? // M | F | O
  numero_ihss_cif     String? /// AES-256-GCM
  numero_rap_cif      String? /// AES-256-GCM
  banco               String?
  cuenta_bancaria_cif String? /// AES-256-GCM
  jefe_id             Int?
  estadoLaboral       String    @default("ACTIVO") // ACTIVO | SUSPENDIDO | VACACIONES | INACTIVO
  causaSalida         String?

  asistencias        RegistroAsistencia[]
  marcajes           Marcaje[]
  horarios           HorarioEmpleado[]
  solicitudes        Solicitud[]
  solicitudesPermiso SolicitudPermiso[]
  nominas            Nomina[]
  notificaciones     Notificacion[]
  contratos          Contrato[]
  historial          HistorialLaboral[]
  documentos         DocumentoEmpleado[]

  @@index([estadoLaboral])
}

model Contrato {
  id              Int       @id @default(autoincrement())
  empleado_id     Int
  empleado        Empleado  @relation(fields: [empleado_id], references: [id], onDelete: Restrict)
  modalidad       String // PERMANENTE | POR_PROYECTO | POR_DIA | POR_HORA
  salarioBaseCent Int /// importes en centavos; prohibido Float
  moneda          String    @default("HNL")
  periodicidad    String // MENSUAL | QUINCENAL | SEMANAL | POR_JORNADA
  aplicaIhss      Boolean   @default(true)
  aplicaRap       Boolean   @default(true)
  vigenciaDesde   DateTime
  vigenciaHasta   DateTime?
  documentoRuta   String?
  creadoEn        DateTime  @default(now())

  @@index([empleado_id, vigenciaDesde])
}

model HistorialLaboral {
  id            Int      @id @default(autoincrement())
  empleado_id   Int
  tipo          String // CAMBIO_PUESTO | AJUSTE_SALARIO | CAMBIO_ESTADO | CAMBIO_DEPTO | CONTRATACION
  valorAnterior String?
  valorNuevo    String
  motivo        String?
  autorizadoPor Int?
  registradoEn  DateTime @default(now())
  empleado      Empleado @relation(fields: [empleado_id], references: [id])

  @@index([empleado_id, registradoEn])
}

model DocumentoEmpleado {
  id          Int      @id @default(autoincrement())
  empleado_id Int
  tipo        String // CONTRATO | DNI | TITULO | CONSTANCIA | AMONESTACION
  nombre      String
  ruta        String /// ruta relativa dentro del almacen local
  mime        String
  tamanoBytes Int
  subidoPor   Int
  subidoEn    DateTime @default(now())
  empleado    Empleado @relation(fields: [empleado_id], references: [id])

  @@index([empleado_id, tipo])
}

// ════════════════════════ ASISTENCIA ════════════════════════

/// Turno configurable: planta, campo o call center.
model Turno {
  id              Int     @id @default(autoincrement())
  nombre          String
  horaEntrada     String // "08:00" en hora local
  horaSalida      String // "17:00"
  cruzaMedianoche Boolean @default(false)
  toleranciaMin   Int     @default(10)
  minutosAlmuerzo Int     @default(60)
  diasSemana      String  @default("1,2,3,4,5") // ISO: 1=lunes
  activo          Boolean @default(true)

  horarios    HorarioEmpleado[]
  asistencias RegistroAsistencia[]
}

/// Asignacion de turno por empleado con vigencia.
model HorarioEmpleado {
  id         Int       @id @default(autoincrement())
  empleadoId Int
  turnoId    Int
  turno      Turno     @relation(fields: [turnoId], references: [id])
  desde      DateTime
  hasta      DateTime?

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, desde])
}

/// Evento crudo de marcaje. Inmutable (trigger); el consolidado es derivado.
model Marcaje {
  id            Int      @id @default(autoincrement())
  empleadoId    Int
  empleado      Empleado @relation(fields: [empleadoId], references: [id])
  ocurridoEn    DateTime
  tipo          String // ENTRADA | SALIDA
  origen        String   @default("WEB") // WEB | MANUAL | IMPORTADO | BIOMETRICO
  dispositivo   String?
  latitud       Float?
  longitud      Float?
  registradoPor Int? /// obligatorio cuando origen = MANUAL
  hashEvento    String   @unique /// idempotencia: sha256(empleado|momento|tipo)
  creadoEn      DateTime @default(now())

  @@index([empleadoId, ocurridoEn])
  @@index([ocurridoEn])
}

/// Consolidado diario derivado del marcaje; un registro por empleado y fecha.
model RegistroAsistencia {
  id                  Int               @id @default(autoincrement())
  empleadoId          Int
  empleado            Empleado          @relation(fields: [empleadoId], references: [id])
  fecha               DateTime /// medianoche local del dia consolidado
  turnoId             Int?
  turno               Turno?            @relation(fields: [turnoId], references: [id])
  horaEntrada         DateTime?
  horaSalida          DateTime?
  minutosTrabajados   Int               @default(0)
  minutosTardanza     Int               @default(0)
  horasExtraDiurnas   Float             @default(0)
  horasExtraNocturnas Float             @default(0)
  estadoDia           String // PRESENTE | AUSENTE | TARDANZA | PERMISO | VACACION | INCAPACIDAD | DESCANSO | FERIADO
  permisoId           Int?
  permiso             SolicitudPermiso? @relation(fields: [permisoId], references: [id], onDelete: SetNull)
  observacion         String?
  cerrado             Boolean           @default(false)
  cerradoPor          Int?
  cerradoEn           DateTime?

  @@unique([empleadoId, fecha])
  @@index([fecha, estadoDia])
}

/// Feriados nacionales y asuetos de empresa; insumo del consolidado.
model DiaFeriado {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @unique
  nombre     String
  tipo       String   @default("NACIONAL") // NACIONAL | EMPRESA
  remunerado Boolean  @default(true)
}

// ═════════════════════════ PERMISOS ═════════════════════════

model Solicitud {
  id              Int      @id @default(autoincrement())
  empleado_id     Int
  empleado        Empleado @relation(fields: [empleado_id], references: [id])
  tipo            String // "VACACIONES" | "PERMISO"
  fecha_solicitud DateTime @default(now())
  fecha_inicio    DateTime
  fecha_fin       DateTime
  motivo          String
  estado          String   @default("PENDIENTE") // "PENDIENTE" | "APROBADA" | "RECHAZADA"

  @@index([empleado_id, estado])
}

// ════════════════════════ PERMISOS (CU03) ════════════════════════

/// Catalogo legal de permisos especiales. Se administra por seed/migracion,
/// no se codifican topes ni bases legales en las rutas.
model TipoPermiso {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique // PERS | ENF | LUTO | MAT | PAT | ESTU
  nombre          String
  remunerado      Boolean @default(true)
  diasMaxAnio     Int?
  requiereSoporte Boolean @default(false)
  baseLegal       String?
  activo          Boolean @default(true)

  solicitudes SolicitudPermiso[]
}

/// Solicitud independiente de vacaciones. El modelo Solicitud anterior se
/// conserva temporalmente para no romper instalaciones que aun lo contengan.
model SolicitudPermiso {
  id                  Int       @id @default(autoincrement())
  folio               String    @unique
  empleadoId          Int
  tipoPermisoId       Int
  fechaInicio         DateTime
  fechaFin            DateTime
  horaInicio          String?
  horaFin             String?
  diasHabiles         Float
  motivo              String
  soporteRuta         String?
  estado              String    @default("SOLICITADO") // SOLICITADO | EN_REVISION | APROBADO | RECHAZADO | CANCELADO
  revisadoPor         Int?
  revisadoEn          DateTime?
  observacionRevision String?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  empleado    Empleado                 @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  tipoPermiso TipoPermiso              @relation(fields: [tipoPermisoId], references: [id], onDelete: Restrict)
  historial   PermisoHistorialEstado[]
  asistencias RegistroAsistencia[]

  @@index([empleadoId, estado])
  @@index([estado, creadoEn])
  @@index([fechaInicio, fechaFin])
}

/// Historial append-only de la máquina de estados.
model PermisoHistorialEstado {
  id             Int      @id @default(autoincrement())
  permisoId      Int
  estadoAnterior String?
  estadoNuevo    String
  usuarioId      Int
  motivo         String?
  ip             String?
  ocurridoEn     DateTime @default(now())

  permiso SolicitudPermiso @relation(fields: [permisoId], references: [id], onDelete: Restrict)

  @@index([permisoId, ocurridoEn])
}

// ═════════════════════════ PLANILLA ═════════════════════════

model Nomina {
  id             Int      @id @default(autoincrement())
  empleado_id    Int
  empleado       Empleado @relation(fields: [empleado_id], references: [id])
  periodo_inicio DateTime
  periodo_fin    DateTime
  fecha_pago     DateTime
  salario_bruto  Decimal
  deducciones    Decimal
  salario_neto   Decimal
}

// ═════════════════ NOTIFICACIONES Y AUDITORÍA ═════════════════

model Notificacion {
  id             Int      @id @default(autoincrement())
  empleado_id    Int
  empleado       Empleado @relation(fields: [empleado_id], references: [id])
  mensaje        String
  leida          Boolean  @default(false)
  fecha_creacion DateTime @default(now())

  @@index([empleado_id, leida])
}

/// Append-only por trigger. Retencion minima cinco anos.
model Auditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  entidad    String
  entidadId  Int?
  accion     String // CREAR | ACTUALIZAR | DESACTIVAR | DESVINCULAR | LOGIN | LOGIN_FALLIDO | ASIGNAR_ROL ...
  antes      String? /// JSON con campos sensibles enmascarados
  despues    String?
  ip         String?
  userAgent  String?
  requestId  String?
  ocurridoEn DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId, ocurridoEn])
}
