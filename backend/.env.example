# Copia este archivo como .env y completa los valores reales.
# Nunca subas el archivo .env al repositorio.

# URL de la base de datos SQLite (relativa a backend/prisma)
DATABASE_URL="file:./dev.db"

# Secreto de firma JWT (access token). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# Clave maestra de cifrado de campos sensibles (base64 de 32 bytes).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ADVERTENCIA: rotarla requiere recifrar los datos existentes.
CLAVE_CIFRADO=""

# Ruta local del almacen de documentos
ALMACEN_RUTA="./storage"

# Puerto HTTP del backend
PORT=3000

# Orígenes permitidos para CORS, separados por coma
ORIGENES_PERMITIDOS="http://localhost:5173"

# Operacion Fase 7
BACKUP_RUTA="./backups"
BACKUP_EXTERNO_RUTA=""
BACKUP_EXTERNO_CLAVE=""
LOG_RUTA="./logs/sirh.jsonl"
RUN_CRON="true"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
ALERTA_FROM=""
ALERTA_TO=""
